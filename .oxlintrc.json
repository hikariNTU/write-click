{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "eqeqeq": "error",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
